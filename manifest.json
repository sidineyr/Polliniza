{
  "manifest_version": 3,
  "name": "Polliniza",
  "version": "0.1.0",
  "description": "Crie uma enquete uma vez. Adapte com inteligência. Publique com controle.",
  "permissions": ["storage", "tabs"],
  "action": {
    "default_title": "Abrir Polliniza",
    "default_popup": "popup.html"
  },
  "options_page": "app.html",
  "background": { "service_worker": "background.js", "type": "module" },
  "browser_specific_settings": {
    "gecko": { "id": "polliniza@sidineyr.github.io", "strict_min_version": "109.0" }
  }
}
